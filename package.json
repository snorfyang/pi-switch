{
  "name": "@snorfyang/pi-switch",
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "description": "Pi extension: keep multiple API keys per provider and switch automatically to the next key when one runs out of quota or hits its rate limit.",
  "keywords": [
    "pi-package",
    "pi",
    "api-key",
    "key-rotation",
    "key-switch",
    "deepseek"
  ],
  "author": "snorfyang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snorfyang/pi-switch.git"
  },
  "homepage": "https://github.com/snorfyang/pi-switch#readme",
  "bugs": {
    "url": "https://github.com/snorfyang/pi-switch/issues"
  },
  "files": [
    "index.ts",
    "keypool.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "load": "pi --no-extensions -e ./index.ts --list-models",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "./test/run-e2e.sh"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "vitest": "^3.2.7"
  }
}
